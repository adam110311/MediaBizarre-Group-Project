@model ProductDetailVM
@{
    ViewData["Title"] = Model.Name;

    string priceDisplay = "€" + Model.Price.ToString("0");

    int fullStars = (int)System.Math.Floor(Model.Rating);
    bool halfStar = Model.Rating - fullStars >= 0.5;
    int emptyStars = 5 - fullStars;
    if (halfStar)
    {
        emptyStars = emptyStars - 1;
    }

    string firstImage = "";
    if (Model.Images.Count > 0)
    {
        firstImage = Model.Images[0];
    }
}

<section class="Container">
    <nav class="Breadcrumb">
        <a asp-controller="Home" asp-action="Categories">Shop all</a>
        <span class="Breadcrumb-sep">›</span>
        <a asp-controller="Home" asp-action="@Model.CategoryAction">@Model.CategoryName</a>
        <span class="Breadcrumb-sep">›</span>
        <span class="Breadcrumb-current">@Model.Name</span>
    </nav>
</section>

<section class="ProductView">
    <div class="ProductView-layout">
        <div class="ProductView-gallery">
            <div class="ProductView-mainImage">
                @if (!string.IsNullOrWhiteSpace(firstImage))
                {
                    <img src="@firstImage" alt="@Model.Name" />
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                }
            </div>
            <div class="ProductView-thumbs">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="ImagePH">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                    </div>
                }
            </div>
        </div>

        <div class="ProductView-info">
            <h1>@Model.Name</h1>
            <div class="ProductView-price">@priceDisplay</div>
            <div class="ProductView-meta">
                <span class="Stars">
                    @for (int i = 0; i < fullStars; i++)
                    {
                        <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    }
                    @if (halfStar)
                    {
                        <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" opacity="0.5"/></svg>
                    }
                    @for (int i = 0; i < emptyStars; i++)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    }
                </span>
                <span>(@Model.Rating.ToString("0.0") stars) · @Model.ReviewCount reviews</span>
            </div>

            <p class="ProductView-desc">@Model.Description</p>

            <div>
                <span class="ProductView-variant-label">Variant</span>
                <div class="ProductView-variants">
                    @for (int i = 0; i < Model.Variants.Count; i++)
                    {
                        string v = Model.Variants[i];
                        string activeClass = "";
                        if (i == 0)
                        {
                            activeClass = "Chip-active";
                        }
                        <button type="button" class="Chip @activeClass">@v</button>
                    }
                </div>
            </div>

            <div class="ProductView-cta-row">
                <div class="Qty">
                    <button type="button" class="QtyDec">−</button>
                    <input type="number" min="1" max="99" value="1" />
                    <button type="button" class="QtyInc">+</button>
                </div>
                <button type="button" class="Btn Btn-primary" data-add-to-cart="@Model.Id">Add to cart</button>
            </div>
            <p class="ProductView-free">Free shipping over €50</p>
        </div>
    </div>
</section>
