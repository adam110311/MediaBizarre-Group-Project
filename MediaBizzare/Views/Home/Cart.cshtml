@model CartVM
@{
    ViewData["Title"] = "Your cart";
}

<section class="Container">
    <nav class="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="Breadcrumb-sep">›</span>
        <span class="Breadcrumb-current">Cart</span>
    </nav>
</section>

<section class="Cart">
    <div>
        <h1>Your cart</h1>
        @if (Model.Items.Count == 0)
        {
            <div class="Cart-empty">
                <p>Your cart is empty.</p>
                <a class="Btn Btn-primary" asp-controller="Home" asp-action="Categories">Start shopping</a>
            </div>
        }
        else
        {
            <div class="Cart-list">
                @foreach (CartItemVM item in Model.Items)
                {
                    <div class="Cart-row" data-variation-id="@item.VariationId" data-unit-price="@item.UnitPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                        <div class="Cart-thumb">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" />
                            }
                        </div>
                        <div>
                            <p class="Cart-name">@item.Name</p>
                            @if (!string.IsNullOrWhiteSpace(item.Variant))
                            {
                                <span class="Cart-variant">@item.Variant</span>
                            }
                        </div>
                        <div class="Qty">
                            <button type="button" class="QtyDec">−</button>
                            <input type="number" min="1" max="99" value="@item.Quantity" class="Cart-qty-input" />
                            <button type="button" class="QtyInc">+</button>
                        </div>
                        <div class="Cart-lineTotal">
                            <strong class="Cart-line-price">€@item.LineTotal.ToString("0.00")</strong>
                        </div>
                        <button type="button" class="Cart-remove">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6l-1.5 14.5A2 2 0 0 1 15.5 22h-7a2 2 0 0 1-2-1.5L5 6"></path>
                                <path d="M10 11v6"></path>
                                <path d="M14 11v6"></path>
                                <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    @if (Model.Items.Count > 0)
    {
        <aside class="Cart-summary">
            <h2>Order summary</h2>
            <dl>
                <dt>Subtotal</dt>
                <dd class="Cart-subtotal-value">€@Model.Subtotal.ToString("0.00")</dd>
                <dt>Shipping</dt>
                <dd class="Cart-shipping-value">
                    @if (Model.Shipping == 0)
                    {
                        <text>Free</text>
                    }
                    else
                    {
                        <text>€@Model.Shipping.ToString("0.00")</text>
                    }
                </dd>
            </dl>
            <dl class="Cart-total">
                <dt>Total</dt>
                <dd class="Cart-total-value">€@Model.Total.ToString("0.00")</dd>
            </dl>
            <a href="#" class="Btn Btn-primary" style="width:100%;">Checkout</a>
            <p class="TextMuted" style="font-size:13px; margin-top:12px;">Free shipping on orders over €50.</p>
        </aside>
    }
</section>
