@model HomeIndexVM
@{
    ViewData["Title"] = "Home";
}

<section class="Hero">
    <div class="Hero-inner">
        <div class="Hero-copy">
            <h1>This week is our biggest sale yet</h1>
            <p>Large discounts</p>
            <div class="Hero-ctas">
                <a class="Btn Btn-primary" asp-controller="Home" asp-action="Categories">Shop now</a>
                <a class="Btn Btn-accent" asp-controller="Home" asp-action="Categories">Shop now</a>
            </div>
        </div>
        <div class="Hero-art">
            <div class="Hero-art-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12" y2="18"></line>
                </svg>
            </div>
        </div>
    </div>
</section>

<section class="Section">
    <h2 class="Section-title">Our products</h2>
    <div class="CatGrid">
        @foreach (CategoryTileVM tile in Model.Categories)
        {
            <partial name="_CategoryTile" model="tile" />
        }
    </div>
</section>

<section class="Bestsellers">
    <div class="Bestsellers-head">
        <div>
            <h2>Bestsellers</h2>
            <p>Our most sold products this month</p>
        </div>
        <a class="Btn Btn-soft" asp-controller="Home" asp-action="Categories">View more</a>
    </div>
    <div class="Bestsellers-carousel">
        <div class="Carousel" id="bestCarousel">
            @foreach (ProductCardVM p in Model.Bestsellers)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
        <div class="Bestsellers-controls">
            <button type="button" id="bestPrev">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <button type="button" id="bestNext">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
        </div>
    </div>
</section>

@{
    ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="~/css/app.css">

<div class="HomePageLength">
    <div class="HomePageDisplay-div text-center">
        <div class="HomePageDisplay-div-container">
            <h1 class="display-4 HomePageDisplay-div-text">This week is our biggest sale yet</h1>
            <span>Large Discounts</span>
            <div class="">
                <button class="btn-HomePage" onclick="navigateTo('/Home/Categories')">Shop Now</button>
                <button class="btn-HomePage btn-HomePage-meta1" onclick="navigateTo('/Home/Categories')" >Shop Now</button>
            </div>
        </div>
        <div class="HomePageDisplay-div2">

        </div>
    </div>

    <div class="OurProductsDiv">
        <div class="OurProduct-title-container">
            <h1 class="OurProducts-title">Our Products</h1>
        </div>
        <div class="BestSellersDiv">
            <div class="BestSellersDiv-container">
                <h1>Bestsellers</h1>
                <p>Our Most Sold Products This Month</p>
            </div>
            <button class="btn-HomePage ViewMore-btn">View More</button>

        </div>
    </div>

    <footer class="footer-div">
        <div class="MediaBizzareLogo">
            <img src="images/logo.png" alt="">
        </div>
    </footer>

    <script>
        function navigateTo(path){
            window.location.href = path;
        }
    </script>

</div>
