@model CategoryTileVM

<a class="CategoryTile" asp-controller="Home" asp-action="Category" asp-route-slug="@Model.Slug">
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <div class="CategoryTile-ph">
            <img src="@Model.ImageUrl" alt="" />
        </div>
    }
    <span class="CategoryTile-name">@Model.Name</span>
    <span class="CategoryTile-arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
    </span>
</a>
