@model CategoryTileVM

<a class="CategoryTile" asp-controller="Home" asp-action="@Model.Action" style="grid-column: span @Model.Span;">
    <div class="CategoryTile-ph">
        @if (string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
        }
        else
        {
            <img src="@Model.ImageUrl" alt="" />
        }
    </div>
    <span class="CategoryTile-name">@Model.Name</span>
    <span class="CategoryTile-arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
    </span>
</a>
