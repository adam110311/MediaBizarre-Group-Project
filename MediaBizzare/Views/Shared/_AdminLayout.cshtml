<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Media Bazar Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body { height: 100%; margin: 0; }

        .Admin-wrapper {
            display: flex;
            min-height: 100vh;
            background: #f8f9fa;
        }

        .Admin-sidebar {
            width: 240px;
            flex-shrink: 0;
            background: #1e293b;
            color: #cbd5e1;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            z-index: 100;
        }

        .Admin-sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 20px 16px;
            color: #f8fafc;
            font-weight: 700;
            font-size: 1rem;
            text-decoration: none;
            border-bottom: 1px solid #334155;
        }

        .Admin-sidebar-brand:hover { color: #f8fafc; }

        .Admin-sidebar-brand svg {
            width: 22px;
            height: 22px;
            flex-shrink: 0;
            color: #f59e0b;
        }

        .Admin-nav {
            padding: 12px 0;
            flex: 1;
        }

        .Admin-nav-section {
            padding: 12px 16px 4px;
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #64748b;
        }

        .Admin-nav-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 20px;
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.875rem;
            transition: background 0.15s, color 0.15s;
            border-left: 3px solid transparent;
        }

        .Admin-nav-link:hover {
            background: #334155;
            color: #f1f5f9;
        }

        .Admin-nav-link.active {
            background: #1d4ed820;
            color: #f1f5f9;
            border-left-color: #f59e0b;
        }

        .Admin-nav-link svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

        .Admin-main {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .Admin-topbar {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 24px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .Admin-topbar-title {
            font-weight: 600;
            font-size: 1rem;
            color: #0f172a;
        }

        .Admin-topbar-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .Admin-topbar-user {
            font-size: 0.875rem;
            color: #475569;
        }

        .Admin-content {
            padding: 28px 32px;
            flex: 1;
        }

        @@media (max-width: 768px) {
            .Admin-sidebar { width: 100%; position: relative; height: auto; }
            .Admin-main { margin-left: 0; }
            .Admin-wrapper { flex-direction: column; }
        }
    </style>
</head>
<body>
@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<div class="Admin-wrapper">

    <aside class="Admin-sidebar">
        <a class="Admin-sidebar-brand" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>Media Bazar Admin</span>
        </a>

        <nav class="Admin-nav">
            <div class="Admin-nav-section">Catalogue</div>
            <a class="Admin-nav-link @(currentController == "Categories" ? "active" : "")"
               asp-controller="Categories" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
                Categories
            </a>
            <a class="Admin-nav-link @(currentController == "Products" ? "active" : "")"
               asp-controller="Products" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"></path>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                Products
            </a>
            <a class="Admin-nav-link @(currentController == "ProductVariations" ? "active" : "")"
               asp-controller="ProductVariations" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M3 12h3m12 0h3M12 3v3m0 12v3"></path>
                </svg>
                Product Variations
            </a>

            <div class="Admin-nav-section">Organisation</div>
            <a class="Admin-nav-link @(currentController == "Departments" ? "active" : "")"
               asp-controller="Departments" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                Departments
            </a>
            <a class="Admin-nav-link @(currentController == "Employees" ? "active" : "")"
               asp-controller="Employees" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                Employees
            </a>
            <a class="Admin-nav-link @(currentController == "Employee_Contract" ? "active" : "")"
               asp-controller="Employee_Contract" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                Contracts
            </a>
            <a class="Admin-nav-link @(currentController == "Roles" ? "active" : "")"
               asp-controller="Roles" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                Job Roles
            </a>

            <div class="Admin-nav-section">Access</div>
            <a class="Admin-nav-link @(currentController == "Users" ? "active" : "")"
               asp-controller="Users" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path>
                </svg>
                Users
            </a>
        </nav>

        <div style="padding: 16px 20px; border-top: 1px solid #334155;">
            <a asp-controller="Home" asp-action="Index" style="display:flex;align-items:center;gap:8px;color:#94a3b8;text-decoration:none;font-size:0.8rem;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;">
                    <path d="M15 18l-6-6 6-6"></path>
                </svg>
                Back to webshop
            </a>
        </div>
    </aside>

    <div class="Admin-main">
        <header class="Admin-topbar">
            <span class="Admin-topbar-title">@(ViewData["Title"] ?? "Dashboard")</span>
            <div class="Admin-topbar-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="Admin-topbar-user">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Log out</button>
                    </form>
                }
            </div>
        </header>

        <div class="Admin-content">
            @RenderBody()
        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
