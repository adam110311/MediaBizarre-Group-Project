@model ProductCardVM
@{
    string price = "€" + Model.Price.ToString("0");
    string oldPrice = "";
    if (Model.OriginalPrice.HasValue)
    {
        oldPrice = "€" + Model.OriginalPrice.Value.ToString("0");
    }
}

<article class="ProductCard">
    <a class="ProductCard-media" asp-controller="Home" asp-action="Product" asp-route-id="@Model.Id">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" />
        }
        else
        {
            <svg class="ProductCard-placeholder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
        }
        <button type="button" class="Btn-icon ProductCard-cart" data-variation-id="@Model.DefaultVariationId">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="8" cy="21" r="1"></circle>
                <circle cx="19" cy="21" r="1"></circle>
                <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
            </svg>
        </button>
    </a>
    <div class="ProductCard-body">
        <h3 class="ProductCard-name">
            <a asp-controller="Home" asp-action="Product" asp-route-id="@Model.Id">@Model.Name</a>
        </h3>
        <div class="ProductCard-priceRow">
            @if (Model.OnSale && Model.OriginalPrice.HasValue)
            {
                <span class="TextStrike">@oldPrice</span>
            }
            <span class="ProductCard-priceNow">@price</span>
            @if (Model.OnSale)
            {
                <span class="SavePill">Save €@Model.Saving.ToString("0")</span>
            }
        </div>
    </div>
</article>
