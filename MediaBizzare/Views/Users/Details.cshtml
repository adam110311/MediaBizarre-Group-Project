@model MediaBizzare.Models.ApplicationUser
@{
    ViewData["Title"] = "User Details";
}

<h1>Details</h1>

<dl class="row">
    <dt class="col-sm-3">Username</dt>     <dd class="col-sm-9">@Model.UserName</dd>
    <dt class="col-sm-3">Email</dt>        <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Name</dt>         <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Surname</dt>      <dd class="col-sm-9">@Model.Surname</dd>
    <dt class="col-sm-3">Phone</dt>        <dd class="col-sm-9">@Model.PhoneNumber</dd>
    <dt class="col-sm-3">Bank account</dt> <dd class="col-sm-9">@Model.BankAccount</dd>
    <dt class="col-sm-3">Street</dt>       <dd class="col-sm-9">@Model.Street @Model.StreetNumber</dd>
    <dt class="col-sm-3">City</dt>         <dd class="col-sm-9">@Model.PostalCode @Model.City</dd>
    <dt class="col-sm-3">Country</dt>      <dd class="col-sm-9">@Model.Country</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
<a asp-action="Index">Back to list</a>
